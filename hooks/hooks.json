{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shell.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking the command against the repo's rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.mjs\"",
            "timeout": 1800,
            "statusMessage": "Phase run: typecheck, lint, changed tests"
          }
        ]
      }
    ]
  }
}
