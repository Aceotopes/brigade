{
  "version": 1,
  "note": "Brigade on itself. The gates test the next version (template/, tests/); tools/ at the root is the released runner doing the building, re-copied by /update-workflow after each release.",
  "guard": {
    "block": []
  },
  "stopGate": {
    "checks": [
      {
        "name": "tests",
        "label": "The plugin's and the template's tests",
        "run": "node --test tests/*.test.mjs template/tools/doc-tools.test.mjs template/tools/phase-run/run.test.mjs template/tools/phase-run/measure.test.mjs",
        "receipt": true
      }
    ]
  },
  "phaseRun": {
    "gates": [
      {
        "label": "plugin tests",
        "run": "node --test tests/*.test.mjs",
        "unreadOf": "tests"
      },
      {
        "label": "template doc-tools tests",
        "run": "node --test template/tools/doc-tools.test.mjs"
      },
      {
        "label": "template runner tests",
        "run": "node --test template/tools/phase-run/run.test.mjs template/tools/phase-run/measure.test.mjs"
      }
    ],
    "tampering": {
      "note": "Brigade's own tests are node:test files; the gate reads these rules from each ticket's base commit.",
      "testFiles": [
        "tests/**/*.test.mjs",
        "template/**/*.test.mjs",
        "tools/**/*.test.mjs"
      ],
      "markers": [
        {
          "name": "skip",
          "pattern": "\\.skip\\s*\\(|[{,]\\s*skip\\s*:"
        },
        {
          "name": "only",
          "pattern": "\\.only\\s*\\(|[{,]\\s*only\\s*:"
        },
        {
          "name": "todo",
          "pattern": "\\.todo\\s*\\(|[{,]\\s*todo\\s*:"
        }
      ],
      "assertions": {
        "pattern": "\\bassert\\.",
        "maxNetRemoved": 3
      },
      "guarded": [
        ".claude/workflow.json"
      ],
      "override": {
        "heading": "Tests removed or weakened"
      }
    }
  }
}
